#!/bin/zsh
set -euo pipefail
PREFIX="${AGENT_STACK_KEYCHAIN_PREFIX:-agent-stack-macbook}"
load_secret() {
  local key="$1"
  local value
  if value=$(security find-generic-password -a "$USER" -s "$PREFIX/$key" -w 2>/dev/null); then
    export "$key=$value"
  fi
}
load_secret OPENAI_API_KEY
load_secret ANTHROPIC_API_KEY
load_secret GITHUB_TOKEN
load_secret LINEAR_API_KEY
load_secret FIGMA_API_KEY
exec "$@"
